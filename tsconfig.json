{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"module": "ESNext",
		"target": "ESNext",
		"sourceMap": true,
		"strict": true
	},
	"exclude": [
		"node_modules",
		".svelte-kit",
		"build",
		"src/service-worker.js",
		"src/service-worker/**/*.js",
		"src/service-worker.ts",
		"src/service-worker/**/*.ts",
		"src/service-worker.d.ts",
		"src/service-worker/**/*.d.ts"
	],
	"include": ["src", "vite.config.ts", "drizzle.config.ts"]
}
